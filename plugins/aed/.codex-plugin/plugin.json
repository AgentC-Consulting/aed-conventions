{
  "name": "aed",
  "description": "Agent-Enhanced Development: naming + process-manager conventions as skills, a planning-stage name checker, and an edit-time naming hook for Ruby, Crystal, and Elixir.",
  "version": "0.2.0",
  "skills": "./skills/",
  "commands": [],
  "hooks": {
    "hooks": {
      "SessionStart": [
        {
          "hooks": [
            {
              "type": "command",
              "command": "ruby \"${PLUGIN_ROOT}/scripts/aed_lint.rb\" --hook",
              "timeout": 15
            }
          ]
        }
      ],
      "PostToolUse": [
        {
          "matcher": "apply_patch|Bash",
          "hooks": [
            {
              "type": "command",
              "command": "ruby \"${PLUGIN_ROOT}/scripts/aed_lint.rb\" --hook",
              "timeout": 15,
              "statusMessage": "Checking AED naming"
            }
          ]
        }
      ]
    }
  },
  "author": { "name": "AgentC Consulting", "url": "https://agentc.consulting" },
  "homepage": "https://github.com/AgentC-Consulting/aed-conventions",
  "repository": "https://github.com/AgentC-Consulting/aed-conventions",
  "license": "MIT"
}
